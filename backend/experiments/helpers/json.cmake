function(json_quote output value)
    string(REPLACE "\\" "\\\\" encoded "${value}")
    string(REPLACE "\"" "\\\"" encoded "${encoded}")
    string(REPLACE "\n" "\\n" encoded "${encoded}")
    string(REPLACE "\r" "\\r" encoded "${encoded}")
    string(REPLACE "\t" "\\t" encoded "${encoded}")
    set(${output} "\"${encoded}\"" PARENT_SCOPE)
endfunction()

function(set_json_string output document key value)
    json_quote(encoded "${value}")
    string(JSON updated SET "${document}" "${key}" "${encoded}")
    set(${output} "${updated}" PARENT_SCOPE)
endfunction()

function(require_positive_integer value label)
    if(NOT "${value}" MATCHES "^[1-9][0-9]*$")
        message(FATAL_ERROR "${label} must be a positive integer")
    endif()
endfunction()
