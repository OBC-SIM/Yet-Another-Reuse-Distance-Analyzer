include("${CMAKE_CURRENT_LIST_DIR}/json.cmake")

function(prepare_input row output)
    string(JSON id GET "${row}" case_id)
    if(NOT id MATCHES "^[a-zA-Z0-9_-]+$")
        message(FATAL_ERROR "invalid case_id: ${id}")
    endif()
    string(JSON fixture GET "${row}" fixture)
    string(JSON expected GET "${row}" expected_status)
    set(source "${YARDA_EXPERIMENTS}/fixtures/${fixture}")
    set(directory "${YARDA_OUTPUT}/inputs/${id}")
    if(EXISTS "${directory}")
        message(FATAL_ERROR "duplicate case_id: ${id}")
    endif()
    file(MAKE_DIRECTORY "${directory}")
    set(defines)
    if(fixture STREQUAL "atax_region.c")
        string(JSON m GET "${row}" m)
        string(JSON n GET "${row}" n)
        require_positive_integer("${m}" "ATAX M")
        require_positive_integer("${n}" "ATAX N")
        list(APPEND defines "-DM=${m}" "-DN=${n}")
    elseif(fixture STREQUAL "fixed_domain.c" OR fixture STREQUAL "growing_domain.c")
        string(JSON domain GET "${row}" domain)
        string(JSON repeats GET "${row}" repeats)
        require_positive_integer("${domain}" "domain")
        require_positive_integer("${repeats}" "repeats")
        list(APPEND defines "-DDOMAIN=${domain}" "-DREPEATS=${repeats}")
    elseif(NOT fixture STREQUAL "dynamic_bound.c")
        message(FATAL_ERROR "unknown evaluation fixture: ${fixture}")
    endif()
    set(lat "${directory}/input.json")
    set(elf "${directory}/input.elf")
    string(TIMESTAMP started "%s" UTC)
    execute_process(COMMAND "${YARDA_REGION}" "${source}" "${lat}" -- ${defines}
        RESULT_VARIABLE status OUTPUT_FILE "${directory}/frontend.stdout"
        ERROR_FILE "${directory}/frontend.stderr" TIMEOUT "${YARDA_TIMEOUT}")
    file(WRITE "${directory}/commands.log"
        "${YARDA_REGION};${source};${lat};--;${defines}\nexit=${status}\n")
    if(NOT status STREQUAL "0")
        file(READ "${directory}/frontend.stderr" error)
        string(JSON reason ERROR_VARIABLE missing GET "${row}" expected_frontend_error)
        if(NOT expected STREQUAL "unsupported" OR missing OR
           NOT status STREQUAL "1" OR NOT error MATCHES "${reason}")
            message(FATAL_ERROR "unexpected frontend failure for ${id}: ${status}\n${error}")
        endif()
        if(EXISTS "${lat}")
            message(FATAL_ERROR "rejected frontend left a LAT artifact: ${lat}")
        endif()
        set_json_string(row "${row}" preparation_status "unsupported")
        set_json_string(row "${row}" preparation_error "${error}")
    else()
        set(compile_flags -std=c11 -O0 -g -fno-pie -no-pie -Wno-unknown-pragmas)
        set(link_flags "-Wl,--section-start=.yarda_lines=0x600000"
            "-Wl,--section-start=.yarda_A=0x600000"
            "-Wl,--section-start=.yarda_x=0x800000"
            "-Wl,--section-start=.yarda_y=0xa00000"
            "-Wl,--section-start=.yarda_tmp=0xc00000")
        execute_process(COMMAND "${YARDA_CLANG}" ${compile_flags} ${defines}
            "${source}" ${link_flags} -o "${elf}" RESULT_VARIABLE status
            OUTPUT_FILE "${directory}/link.stdout" ERROR_FILE "${directory}/link.stderr"
            TIMEOUT "${YARDA_TIMEOUT}")
        file(APPEND "${directory}/commands.log"
            "${YARDA_CLANG};${compile_flags};${defines};${source};${link_flags};-o;${elf}\nexit=${status}\n")
        if(NOT status STREQUAL "0")
            message(FATAL_ERROR "ET_EXEC generation failed for ${id}: ${status}")
        endif()
        set_json_string(row "${row}" preparation_status "success")
        set_json_string(row "${row}" input_compile_flags "${compile_flags};${defines};${link_flags}")
        foreach(kind lat elf)
            file(SHA256 "${${kind}}" hash)
            set_json_string(row "${row}" "${kind}_sha256" "${hash}")
            set_json_string(row "${row}" "${kind}_path" "${${kind}}")
        endforeach()
    endif()
    string(TIMESTAMP finished "%s" UTC)
    math(EXPR seconds "${finished} - ${started}")
    string(JSON row SET "${row}" preparation_wall_seconds "${seconds}")
    file(SHA256 "${source}" hash)
    set_json_string(row "${row}" source_sha256 "${hash}")
    set_json_string(row "${row}" source_path "${source}")
    string(JSON cache GET "${row}" cache_path)
    cmake_path(ABSOLUTE_PATH cache BASE_DIRECTORY "${YARDA_ROOT}" NORMALIZE)
    file(SHA256 "${cache}" hash)
    set_json_string(row "${row}" cache_path "${cache}")
    set_json_string(row "${row}" cache_sha256 "${hash}")
    set_json_string(row "${row}" selection_scope "APE_ANALYZE")
    set_json_string(row "${row}" compiler_pipeline "clang14-o0-region-v1")
    set_json_string(row "${row}" analyzer_build_flags "${YARDA_BUILD_FLAGS}")
    string(JSON row SET "${row}" preparation_in_timing true)
    file(WRITE "${directory}/case.json" "${row}\n")
    set(${output} "${directory}/case.json" PARENT_SCOPE)
endfunction()
