cmake_minimum_required(VERSION 3.20)
cmake_path(ABSOLUTE_PATH YARDA_BUILD_DIR NORMALIZE)
cmake_path(ABSOLUTE_PATH YARDA_MANIFEST NORMALIZE)

get_filename_component(YARDA_EXPERIMENTS "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
include("${YARDA_BUILD_DIR}/backend/experiments/environment.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/prepare_inputs.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/run_samples.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/provenance.cmake")

if(EXISTS "${YARDA_OUTPUT}")
    message(FATAL_ERROR "evaluation output must be a new directory: ${YARDA_OUTPUT}")
endif()
require_positive_integer("${YARDA_REPETITIONS}" "repetitions")
file(READ "${YARDA_MANIFEST}" manifest)
string(JSON version GET "${manifest}" schema_version)
if(NOT version EQUAL 1)
    message(FATAL_ERROR "unsupported evaluation manifest version")
endif()
string(JSON YARDA_TIMEOUT GET "${manifest}" timeout_seconds)
string(JSON YARDA_MEMORY_KIB GET "${manifest}" memory_limit_kib)
require_positive_integer("${YARDA_TIMEOUT}" "timeout")
require_positive_integer("${YARDA_MEMORY_KIB}" "memory limit")
cmake_path(ABSOLUTE_PATH YARDA_OUTPUT NORMALIZE)
file(MAKE_DIRECTORY "${YARDA_OUTPUT}/inputs" "${YARDA_OUTPUT}/runs")
configure_file("${YARDA_MANIFEST}" "${YARDA_OUTPUT}/manifest.json" COPYONLY)
record_provenance()
string(JSON count LENGTH "${manifest}" cases)
if(count EQUAL 0)
    message(FATAL_ERROR "evaluation requires at least one case")
endif()
math(EXPR last "${count} - 1")
set(prepared_cases)
foreach(index RANGE 0 ${last})
    string(JSON row GET "${manifest}" cases "${index}")
    prepare_input("${row}" prepared)
    list(APPEND prepared_cases "${prepared}")
endforeach()

set(sample_index "[]")
set(unexpected "")
foreach(case_file IN LISTS prepared_cases)
    file(READ "${case_file}" row)
    string(JSON id GET "${row}" case_id)
    string(JSON preparation GET "${row}" preparation_status)
    string(JSON expected GET "${row}" expected_status)
    set(directory "${YARDA_OUTPUT}/runs/${id}")
    file(MAKE_DIRECTORY "${directory}")
    if(preparation STREQUAL "unsupported")
        file(WRITE "${directory}/preparation.json"
            "{\"case_id\":\"${id}\",\"mode\":\"prepare\",\"status\":\"unsupported\"}\n")
        append_sample("${directory}/preparation.json")
        continue()
    endif()
    if(expected STREQUAL "success")
        run_evaluation("${case_file}" verify "${directory}/verify" status)
        if(NOT status STREQUAL "success")
            append_sample("${directory}/verify/measurement.json")
            list(APPEND unexpected "${id}: verification ${status}")
            continue()
        endif()
        verify_cli("${case_file}" "${directory}/verify")
        foreach(mode batch streaming instrumented)
            run_evaluation("${case_file}" "${mode}" "${directory}/warmup-${mode}" status)
            if(NOT status STREQUAL "success")
                list(APPEND unexpected "${id}: warmup ${mode} ${status}")
            endif()
        endforeach()
        foreach(repetition RANGE 1 ${YARDA_REPETITIONS})
            math(EXPR parity "${repetition} % 2")
            if(parity)
                set(modes batch streaming instrumented)
            else()
                set(modes instrumented streaming batch)
            endif()
            foreach(mode IN LISTS modes)
                set(sample "${directory}/${mode}-${repetition}")
                run_evaluation("${case_file}" "${mode}" "${sample}" status)
                append_sample("${sample}/measurement.json")
                if(status STREQUAL "success")
                    compare_result("${directory}/verify/result.json" "${sample}/result.json")
                else()
                    list(APPEND unexpected "${id}: ${mode} ${status}")
                endif()
            endforeach()
        endforeach()
    elseif(expected STREQUAL "budget_exhaustion")
        foreach(mode batch streaming instrumented)
            run_evaluation("${case_file}" "${mode}" "${directory}/${mode}" status)
            append_sample("${directory}/${mode}/measurement.json")
            if(NOT status STREQUAL "${expected}")
                list(APPEND unexpected "${id}: ${mode} ${status}, expected ${expected}")
            endif()
        endforeach()
    else()
        message(FATAL_ERROR "unexpected prepared-case status: ${expected}")
    endif()
    message(STATUS "Evaluated ${id}")
endforeach()
file(WRITE "${YARDA_OUTPUT}/samples.json" "${sample_index}\n")
execute_process(COMMAND "${YARDA_EVALUATOR}" summarize "${YARDA_OUTPUT}/samples.json"
    "${YARDA_OUTPUT}/summary.json" RESULT_VARIABLE status)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "sample aggregation failed")
endif()
if(unexpected)
    message(FATAL_ERROR "incomplete evaluation: ${unexpected}")
endif()
