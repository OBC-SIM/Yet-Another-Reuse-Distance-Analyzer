include("${CMAKE_CURRENT_LIST_DIR}/json.cmake")
file(READ "${result_file}" payload)
check_input_identity()
assert_json("2" schema_version)
assert_json("hierarchy-rd" analysis_mode)
assert_json("exact-two-level-lru-demand-v1" model_id)
assert_json("full-exact" csrd_mode)
assert_json("linked_absolute" address_basis)
assert_json("0" selected_path core_id)
assert_json("L1" selected_path l1_name)
assert_json("LLC" selected_path llc_name)
assert_json("Memory" selected_path memory_name)
assert_json("2" inputs map_schema_version)
assert_json("1" inputs cache_schema_version)
assert_json("ELF64" inputs elf_class)
assert_json("62" inputs elf_machine)
assert_json_length(2 cache_hierarchy levels)
foreach(level 0 1)
    assert_json("32" cache_hierarchy levels ${level} line_size_bytes)
    assert_json("2" cache_hierarchy levels ${level} associativity)
    assert_json("LRU" cache_hierarchy levels ${level} replacement)
endforeach()
assert_json("128" cache_hierarchy levels 0 size_bytes)
assert_json("2" cache_hierarchy levels 0 set_count)
assert_json("256" cache_hierarchy levels 1 size_bytes)
assert_json("4" cache_hierarchy levels 1 set_count)
assert_json_length(4 tasks)
set(ids conflicts span cold empty)
set(sources 11 2 1 0)
set(references 11 4 1 0)
set(l1_hits 2 2 0 0)
set(llc_hits 2 0 0 0)
set(memory 7 2 1 0)
set(cold 6 2 1 0)
foreach(task RANGE 0 3)
    foreach(list_name ids sources references l1_hits llc_hits memory cold)
        list(GET ${list_name} ${task} ${list_name}_value)
    endforeach()
    assert_json("${ids_value}" tasks ${task} task_id)
    assert_json("${sources_value}" tasks ${task} source_accesses)
    assert_json("${references_value}" tasks ${task} modeled_accesses)
    assert_json("${l1_hits_value}" tasks ${task} l1_first_hit_count)
    assert_json("${llc_hits_value}" tasks ${task} llc_first_hit_count)
    assert_json("${memory_value}" tasks ${task} all_cache_miss_count)
    foreach(level l1 llc)
        assert_json("${cold_value}" tasks ${task} ${level} cold_misses)
        assert_json("${cold_value}" tasks ${task} ${level} unique_lines)
    endforeach()
    assert_json("${sources_value}" tasks ${task} coverage source_accesses)
    assert_json("${sources_value}" tasks ${task} coverage resolved_accesses)
    assert_json("${references_value}" tasks ${task} coverage emitted_line_references)
    assert_json("0" tasks ${task} coverage rejected_accesses)
    assert_json("0" tasks ${task} coverage excluded_opaque_call_sites)
    assert_json("ON" tasks ${task} coverage complete)
    foreach(flag level_conservation_l1 level_conservation_llc
                 llc_input_matches_l1_misses first_service_conservation all_passed)
        assert_json("ON" tasks ${task} invariants ${flag})
    endforeach()
endforeach()
assert_json("9" tasks 0 l1 misses)
assert_json("3" tasks 0 l1 replacement_misses)
assert_json("9" tasks 0 llc lookups)
assert_json("7" tasks 0 llc misses)
assert_json("1" tasks 0 llc replacement_misses)
assert_json_length(4 tasks 0 l1 csrd_histogram)
assert_json("2" tasks 0 l1 csrd_histogram 0)
foreach(distance 2 3 4)
    assert_json("1" tasks 0 l1 csrd_histogram ${distance})
endforeach()
assert_json_length(3 tasks 0 llc csrd_histogram)
foreach(distance 0 1 2)
    assert_json("1" tasks 0 llc csrd_histogram ${distance})
endforeach()
assert_json_length(1 tasks 1 l1 csrd_histogram)
assert_json("2" tasks 1 l1 csrd_histogram 0)
assert_json_length(0 tasks 1 llc csrd_histogram)
foreach(level l1 llc)
    assert_json_length(0 tasks 3 ${level} csrd_histogram)
endforeach()
foreach(ratio l1_first_hit_ratio llc_first_hit_ratio all_cache_miss_ratio)
    assert_json_type(NULL tasks 3 ${ratio})
endforeach()
foreach(field events telemetry total_time_ns stage_time_ns peak_rss_bytes
              measured_at_utc host)
    assert_absent(${field})
endforeach()
