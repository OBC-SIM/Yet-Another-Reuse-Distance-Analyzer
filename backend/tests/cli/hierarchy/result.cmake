cmake_minimum_required(VERSION 3.20)

include("${CMAKE_CURRENT_LIST_DIR}/common.cmake")
run_ok(${base})
file(READ "${result_file}" original)
set(payload "${original}")
assert_json("2" schema_version)
assert_json("hierarchy-rd" analysis_mode)
assert_json("exact-two-level-lru-demand-v1" model_id)
assert_json("full-exact" csrd_mode)
assert_json("linked_absolute" address_basis)
assert_json("0" selected_path core_id)
assert_json("L1D0" selected_path l1_name)
assert_json("L2" selected_path llc_name)
assert_json("2" inputs map_schema_version)
assert_json("1" inputs cache_schema_version)
assert_json("ELF64" inputs elf_class)
assert_json("62" inputs elf_machine)
foreach(kind map elf cache)
    if(kind STREQUAL "map")
        set(input "${map}")
        set(field map_sha256)
    elseif(kind STREQUAL "elf")
        set(input "${YARDA_ELF}")
        set(field elf_sha256)
    else()
        set(input "${YARDA_CACHE}")
        set(field cache_config_sha256)
    endif()
    file(SHA256 "${input}" expected)
    assert_json("${expected}" inputs ${field})
    set(${field} "${expected}")
endforeach()
string(JSON version GET "${payload}" tool_version)
# Independent SHA-256 over the documented compact, sorted preimage.
string(CONCAT preimage
    "{\"address_basis\":\"linked_absolute\",\"analysis_core_id\":0,"
    "\"analysis_mode\":\"hierarchy-rd\",\"cache_config_sha256\":\"${cache_config_sha256}\","
    "\"csrd_mode\":\"full-exact\",\"elf_sha256\":\"${elf_sha256}\","
    "\"map_sha256\":\"${map_sha256}\",\"model_id\":\"exact-two-level-lru-demand-v1\","
    "\"schema_version\":2,\"semantic_analysis_options\":{},\"tool_version\":\"${version}\"}")
string(SHA256 expected_id "${preimage}")
assert_json("${expected_id}" analysis_id)
assert_json("first" tasks 0 task_id)
assert_json("second" tasks 1 task_id)
assert_json("empty" tasks 2 task_id)
# Each 8-byte reference at 0x60001c touches two lines; tasks start cold.
foreach(task 0 1)
    assert_json("2" tasks ${task} source_accesses)
    assert_json("4" tasks ${task} modeled_accesses)
    assert_json("2" tasks ${task} l1_first_hit_count)
    assert_json("0" tasks ${task} llc_first_hit_count)
    assert_json("2" tasks ${task} all_cache_miss_count)
    assert_json("2" tasks ${task} l1 csrd_histogram 0)
    assert_json("ON" tasks ${task} coverage complete)
    assert_json("ON" tasks ${task} invariants all_passed)
endforeach()
assert_json("0" tasks 2 modeled_accesses)
string(JSON null_type TYPE "${payload}" tasks 2 l1_first_hit_ratio)
if(NOT null_type STREQUAL "NULL")
    message(FATAL_ERROR "empty ratio must be null")
endif()
run_ok(${base})
file(READ "${result_file}" repeated)
if(NOT original STREQUAL repeated)
    message(FATAL_ERROR "RESULT differs on repeated invocation")
endif()
configure_file("${map}" "${YARDA_WORK_DIR}/renamed.json" COPYONLY)
list(REMOVE_AT base 0)
run_ok("${YARDA_WORK_DIR}/renamed.json" ${base})
file(READ "${result_file}" renamed)
if(NOT original STREQUAL renamed)
    message(FATAL_ERROR "input path entered RESULT identity")
endif()
file(APPEND "${YARDA_WORK_DIR}/renamed.json" "\n")
run_ok("${YARDA_WORK_DIR}/renamed.json" ${base})
file(READ "${result_file}" payload)
string(JSON changed_id GET "${payload}" analysis_id)
if(changed_id STREQUAL expected_id)
    message(FATAL_ERROR "raw input whitespace did not change analysis identity")
endif()
