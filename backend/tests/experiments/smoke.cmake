cmake_minimum_required(VERSION 3.20)
file(READ "${YARDA_EXPERIMENTS}/cache_hierarchy_manifest.json" manifest)
string(JSON cases LENGTH "${manifest}" cases)
math(EXPR last "${cases} - 1")
set(selected "[]")
foreach(index RANGE 0 ${last})
    string(JSON row GET "${manifest}" cases "${index}")
    string(JSON id GET "${row}" case_id)
    if(id STREQUAL "fixed-v16-n1024" OR id STREQUAL "growing-v64-n131072" OR
       id STREQUAL "atax-micro" OR
       id STREQUAL "source-budget-exhaustion" OR id STREQUAL "unsupported-dynamic-bound")
        if(id STREQUAL "growing-v64-n131072")
            string(JSON row SET "${row}" case_id "\"growing-v64-n1024\"")
            string(JSON row SET "${row}" repeats 8)
            string(JSON row SET "${row}" expected_sources 1024)
            string(JSON row SET "${row}" reference_scale 1024)
        endif()
        string(JSON size LENGTH "${selected}")
        string(JSON selected SET "${selected}" "${size}" "${row}")
    endif()
endforeach()
string(JSON size LENGTH "${selected}")
if(NOT size EQUAL 5)
    message(FATAL_ERROR "smoke case selection is incomplete")
endif()
string(JSON manifest SET "${manifest}" cases "${selected}")
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef token)
set(work "${YARDA_WORK}/smoke-${token}")
file(MAKE_DIRECTORY "${work}")
file(WRITE "${work}/manifest.json" "${manifest}")
execute_process(COMMAND sh "${YARDA_EXPERIMENTS}/run_cache_hierarchy_evaluation.sh"
    "${YARDA_BUILD_DIR}" "${work}/results" "${work}/manifest.json" 1
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "evaluation smoke failed: ${status}\n${output}\n${error}")
endif()
file(READ "${work}/results/summary.json" summary)
string(JSON rows LENGTH "${summary}")
if(NOT rows EQUAL 13)
    message(FATAL_ERROR "expected nine successful and four failed-only groups: ${summary}")
endif()
