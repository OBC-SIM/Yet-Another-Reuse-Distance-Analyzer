cmake_minimum_required(VERSION 3.20)
include("${YARDA_BUILD_DIR}/backend/experiments/environment.cmake")
include("${YARDA_EXPERIMENTS}/helpers/prepare_inputs.cmake")
include("${YARDA_EXPERIMENTS}/helpers/run_samples.cmake")
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef token)
set(YARDA_OUTPUT "${YARDA_WORK}/failures-${token}")
file(MAKE_DIRECTORY "${YARDA_OUTPUT}")
set(YARDA_TIMEOUT 30)
set(YARDA_MEMORY_KIB 2097152)
file(READ "${YARDA_EXPERIMENTS}/cache_hierarchy_manifest.json" manifest)
string(JSON row GET "${manifest}" cases 0)
prepare_input("${row}" case_file)
file(READ "${case_file}" original)
foreach(key single_loop cumulative_loop source_accesses line_references)
    string(JSON changed SET "${original}" effective_work_limits "${key}" 0)
    set(input "${YARDA_OUTPUT}/${key}.json")
    file(WRITE "${input}" "${changed}")
    foreach(mode batch streaming instrumented)
        run_evaluation("${input}" "${mode}" "${YARDA_OUTPUT}/${key}-${mode}" status)
        if(NOT status STREQUAL "budget_exhaustion")
            message(FATAL_ERROR "wrong ${key}/${mode} failure: ${status}")
        endif()
    endforeach()
endforeach()
string(JSON changed SET "${original}" expected_sources 1025)
file(WRITE "${YARDA_OUTPUT}/wrong-sources.json" "${changed}")
run_evaluation("${YARDA_OUTPUT}/wrong-sources.json" verify "${YARDA_OUTPUT}/wrong-sources" status)
if(NOT status STREQUAL "error")
    message(FATAL_ERROR "incorrect independent source expectation was accepted")
endif()

run_evaluation("${case_file}" streaming "${YARDA_OUTPUT}/preserved" status)
if(NOT status STREQUAL "success")
    message(FATAL_ERROR "preservation baseline failed")
endif()
file(SHA256 "${YARDA_OUTPUT}/preserved/result.json" before)
execute_process(COMMAND "${YARDA_EVALUATOR}" "${case_file}" streaming
    "${YARDA_OUTPUT}/preserved" RESULT_VARIABLE status ERROR_VARIABLE error)
file(SHA256 "${YARDA_OUTPUT}/preserved/result.json" after)
if(NOT status STREQUAL "1" OR NOT error MATCHES "directory must be new" OR NOT before STREQUAL after)
    message(FATAL_ERROR "existing results were not preserved")
endif()

set(raw_sample "${YARDA_OUTPUT}/raw-sample.json")
configure_file("${YARDA_OUTPUT}/preserved/measurement.json" "${raw_sample}" COPYONLY)
json_quote(encoded "${raw_sample}")
file(WRITE "${YARDA_OUTPUT}/sample-index.json" "[${encoded}]")
file(SHA256 "${raw_sample}" before)
execute_process(COMMAND "${YARDA_EVALUATOR}" summarize
    "${YARDA_OUTPUT}/sample-index.json" "${raw_sample}"
    RESULT_VARIABLE status ERROR_VARIABLE error)
file(SHA256 "${raw_sample}" after)
if(NOT status STREQUAL "1" OR NOT error MATCHES "artifact output aliases input:" OR
   NOT before STREQUAL after)
    message(FATAL_ERROR "summary output overwrote its raw input sample")
endif()

# A compact MAP produces a large batch without a large compiler working set.
string(JSON row GET "${manifest}" cases 3)
prepare_input("${row}" large_case)
set(YARDA_MEMORY_KIB 262144)
run_evaluation("${large_case}" batch "${YARDA_OUTPUT}/memory-limit" status)
if(NOT status STREQUAL "resource_failure")
    message(FATAL_ERROR "expected classified allocation failure, got ${status}")
endif()

# Exercise the timeout branch using a child that cannot finish in its allowance.
set(YARDA_TIMEOUT 0.05)
set(YARDA_EVALUATOR "${YARDA_OUTPUT}/sleep-wrapper.sh")
file(WRITE "${YARDA_EVALUATOR}" "#!/bin/sh\nsleep 5\n")
file(CHMOD "${YARDA_EVALUATOR}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
run_evaluation("${case_file}" streaming "${YARDA_OUTPUT}/timeout" status)
if(NOT status STREQUAL "timeout")
    message(FATAL_ERROR "expected timeout, got ${status}")
endif()
